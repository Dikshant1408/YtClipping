# Copy to .env (gitignored) and fill in. Loaded automatically by autoclip_watch.py
# and passed to the AutoClip CLI for analysis.

# --- Analysis model: Groq (free, fast, generous limits) ---
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.groq.com/openai/v1
API_OPENAI_API_KEY=gsk_your_key_here
API_MODEL_NAME=qwen/qwen3.8-27b
API_MAX_TOKENS=4096

# --- Google Gemini (alternative) ---
# LLM_PROVIDER=gemini
# API_GEMINI_API_KEY=your_gemini_key_here
# API_MODEL_NAME=gemini-3.8-flash
# API_MAX_TOKENS=4096

# --- OpenAI / compatible (alternative) ---
# LLM_PROVIDER=openai
# API_OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# API_MODEL_NAME=gpt-4o-mini

# --- Local Ollama (alternative, no key) ---
# LLM_PROVIDER=ollama
# API_MODEL_NAME=qwen2.5:7b

# --- AutoClip data dir (use a plain local path without spaces) ---
AUTOCLIP_DATA_DIR=D:\acdata

# --- Produce more clips per video: keep candidates scoring 0.5+ (default 0.7) ---
PROCESSING_MIN_SCORE_THRESHOLD=0.5

# --- Subtitle script: "roman" (Hinglish, default) or "devanagari" (Hindi script) ---
TRANSCRIBE_SCRIPT=roman

# --- Publishing (only if NOT using the built-in direct YouTube uploader) ---
# The built-in uploader uses client_secret.json + token.json (YouTube Data API).
# Upload-Post is an optional fallback:
# UPLOAD_POST_API_KEY=
# UPLOAD_POST_USER=